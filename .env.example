APP_NAME="Project"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# ==== Database ====
# Lokal (Docker): pakai konfigurasi di bawah ini, cocok dengan service "db" di docker-compose.yml
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=project_app
DB_USERNAME=project_user
DB_PASSWORD=secret

# Production: ganti DB_HOST, DB_USERNAME, DB_PASSWORD dengan kredensial dari Neon.tech
# DB_HOST=your-project.neon.tech
# DB_SSLMODE=require

# ==== Redis (cache & queue) ====
# Lokal (Docker): pakai service "redis"
REDIS_HOST=rahasia
REDIS_PASSWORD=hoho
REDIS_PORT=6379

# Production: ganti dengan kredensial dari Upstash
# REDIS_HOST=your-upstash-endpoint.upstash.io
# REDIS_PASSWORD=your-upstash-password
# REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# ==== File storage ====
FILESYSTEM_DISK=local
# Production: ganti ke "s3" dan isi kredensial Cloudflare R2
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# ==== Email (Resend) ====
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=apa ya
MAIL_PASSWORD=
MAIL_ENCRYPTION=emang iya?

# ==== CORS (sesuaikan dengan domain frontend Next.js) ====
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

# ==== Monitoring ====
SENTRY_LARAVEL_DSN=